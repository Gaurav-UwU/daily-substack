# ============================================================
# Copy this file to .env for local runs. In GitHub Actions,
# set these as repository Secrets (Settings > Secrets > Actions)
# instead. NEVER commit a real .env.
# ============================================================

# --- NVIDIA NIM (the brain) -- REQUIRED ---------------------
# Free key from https://build.nvidia.com (format: nvapi-...)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional model overrides (defaults are sensible)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# A reasoning model improves topic ranking + the quality gate.
# Leave blank to reuse NVIDIA_MODEL for everything.
NVIDIA_MODEL_REASON=

# --- Substack (publishing) -- REQUIRED ----------------------
# Your publication URL, e.g. https://gauravmankele.substack.com
SUBSTACK_PUBLICATION_URL=https://your-handle.substack.com
# Cookie string copied from a logged-in browser session (see README).
# This is the robust auth path for CI. The substack.sid cookie matters most.
SUBSTACK_COOKIES_STRING=
# Fallback auth if your account has a password set (many Substack
# accounts are magic-link only and have NO password; use cookies then).
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=

# --- Behaviour ----------------------------------------------
# gate  = auto-publish only if the draft clears QUALITY_THRESHOLD, else keep as draft
# draft = always stop at draft (never auto-publish)
# auto  = always publish, no gate
PUBLISH_MODE=gate
QUALITY_THRESHOLD=78
# Draft only, never touch Substack at all (great for first test runs):
DRY_RUN=false

# --- Optional discovery boosters ----------------------------
# Free Exa key (https://exa.ai) gives the agent semantic web search.
EXA_API_KEY=
# Optional: post a run summary to Slack/Discord/any incoming webhook.
NOTIFY_WEBHOOK=

# --- Optional: cookie-gated social via agent-reach ----------
# Only needed if you want Twitter/X + Reddit + LinkedIn signal.
# Path or string of exported browser cookies for agent-reach.
AGENT_REACH_ENABLED=false
